{
  "name": "skyflow-plugin",
  "description": "Skyflow plugin for Claude Code",
  "version": "0.1.0",
  "author": {
    "name": "Joseph McCarron"
  },
  "mcpServers": {
    "sky-dev": {
      "type": "http",
      "url": "https://sky-dev-mcp.vercel.app/mcp?accountId=${SKYFLOW_ACCOUNT_ID}",
      "headers": {
        "Authorization": "Bearer ${SKYFLOW_BEARER_TOKEN}"
      }
    }
  }
}
